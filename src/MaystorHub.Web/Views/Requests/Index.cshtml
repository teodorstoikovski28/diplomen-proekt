@model IEnumerable<MaystorHub.Web.Models.ServiceRequest>
@{ ViewData["Title"] = "Активни заявки"; }
<h1>Активни заявки</h1>
<p class="text-muted">На тази страница ще се показват отворени заявки без публично разкриване на точния адрес.</p>
<div class="row g-3">
@foreach (var request in Model)
{
    <div class="col-12"><article class="card shadow-sm"><div class="card-body"><div class="d-flex justify-content-between flex-wrap gap-2"><h2 class="h5">@request.Title</h2><span class="badge text-bg-light">@request.ServiceCategory?.Name</span></div><p>@request.Description</p><p class="mb-0 small text-muted">@request.City · Бюджет: @(request.BudgetMin?.ToString("0.00") ?? "-") – @(request.BudgetMax?.ToString("0.00") ?? "-") лв.</p></div></article></div>
}
</div>
@if (!Model.Any()) { <div class="alert alert-light border">Все още няма активни заявки.</div> }
