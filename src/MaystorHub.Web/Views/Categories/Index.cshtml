@model IEnumerable<MaystorHub.Web.Models.ServiceCategory>
@{ ViewData["Title"] = "Категории услуги"; }
<h1>Категории услуги</h1>
<p class="text-muted">Изберете категория, за да намерите подходящи услуги.</p>
<div class="row g-3">
@foreach (var category in Model)
{
    <div class="col-md-6 col-lg-4"><article class="card h-100 shadow-sm"><div class="card-body"><h2 class="h5">@category.Name</h2><p>@category.Description</p></div></article></div>
}
</div>
