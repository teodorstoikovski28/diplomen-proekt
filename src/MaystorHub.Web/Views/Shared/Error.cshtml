@model MaystorHub.Web.Models.ErrorViewModel
@{ ViewData["Title"] = "Възникна грешка"; }
<div class="error-panel mx-auto text-center p-5 rounded-4">
    <p class="eyebrow">Възникна проблем</p>
    <h1 class="h2">Заявката не можа да бъде изпълнена.</h1>
    <p class="text-muted">Опитайте отново след малко. Ако проблемът продължи, изпратете идентификатора на заявката на администратора.</p>
    @if (Model.ShowRequestId) { <p class="small">Идентификатор: <code>@Model.RequestId</code></p> }
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Към началната страница</a>
</div>
