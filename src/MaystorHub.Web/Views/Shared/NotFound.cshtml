@{ ViewData["Title"] = "Страницата не е намерена"; }
<div class="error-panel mx-auto text-center p-5 rounded-4">
    <p class="eyebrow">Грешка 404</p>
    <h1 class="h2">Тази страница не е намерена.</h1>
    <p class="text-muted">Адресът може да е променен или страницата да не съществува.</p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Към началната страница</a>
</div>
